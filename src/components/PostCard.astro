---
import type { CollectionEntry } from 'astro:content';
import { getCategory, getCategoryId } from '../data/categories';
import { useTranslations, type Lang } from '../i18n/utils';
import { formatDate } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = post.id.replace(/^es\//, '').replace(/\.mdx?$/, '');
const href = `${base}${lang === 'es' ? '/es' : ''}/${slug}/`;
const categoryId = getCategoryId(post.data.category);
const category = categoryId ? getCategory(categoryId, lang) : undefined;
---

<article class="post-card">
  {category && (
    <a class="post-card__image-link" href={href} tabindex="-1" aria-hidden="true">
      <img
        class="post-card__image"
        src={category.coverImage}
        alt=""
        width="720"
        height="405"
        loading="lazy"
      />
    </a>
  )}

  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime={post.data.date}>{formatDate(post.data.date, lang)}</time>
      <span aria-hidden="true">·</span>
      <span class="post-card__difficulty">{post.data.difficulty}</span>
    </div>

    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <a class="post-card__read-more" href={href}>
      {t('blog.readmore')} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    box-sizing: border-box;
    flex-direction: column;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #0A0F1B;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .post-card:hover {
    border-color: #64748b;
  }

  .post-card__image-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid #334155;
    background: #0a0a0a;
    line-height: 0;
  }

  .post-card__image {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    object-fit: cover;
    object-position: center;
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.55rem;
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .post-card__difficulty {
    color: #cbd5e1;
  }

  h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  h3 a {
    color: #f8fafc;
  }

  h3 a:hover {
    color: #ef4444;
  }

  p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.6rem 0 0.85rem;
    font-size: 0.87rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .post-card__read-more {
    margin-top: auto;
    font-size: 0.84rem;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }
  }
</style>
