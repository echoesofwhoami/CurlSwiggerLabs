---
import ExternalLink from '@components/mdx/ExternalLink.astro'
import Choose from '@components/Choose.astro'
import { conceptReferences } from '@data/glossary'
import '@styles/post/TooltipReferences.css'

const items = conceptReferences(Astro.locals.usedTips ?? [])
---

<Choose if={items.length > 0}>
  <section slot="then" class="tooltip-references" aria-labelledby="tooltip-references-title">
    <h2 id="tooltip-references-title">Concepts referenced</h2>
    <p>These are the concepts highlighted in this writeup.</p>
    <ul class="tooltip-references-list">
      {items.map((item) => (
        <li>
          <strong>{item.term}</strong>
          <p>{item.short}</p>
          <Choose if={item.refs.length > 0}>
            <ul slot="then" class="tooltip-references-links">
              {item.refs.map((ref) => (
                <li>
                  <ExternalLink text={ref.title} url={ref.url} />
                </li>
              ))}
            </ul>
          </Choose>
        </li>
      ))}
    </ul>
  </section>
</Choose>
