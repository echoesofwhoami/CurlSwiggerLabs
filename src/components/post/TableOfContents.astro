---
import type { TableOfContentsProps as Props } from '@types';
import '@styles/post/TableOfContents.css';

const { headings } = Astro.props;
const visibleHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);

---

{visibleHeadings.length > 0 && (
  <nav class="table-of-contents" aria-labelledby="toc-title">
    <h2 id="toc-title">On this page</h2>
    <ol>
      {visibleHeadings.map((heading) => (
        <li class:list={{ nested: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

