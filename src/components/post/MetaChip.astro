---
import { Image } from 'astro:assets';
import { getChipVisual } from '../../data/chipIcons';
import type { MetaChipProps as Props } from '@types';
import '@styles/post/MetaChip.css';

const { label } = Astro.props;
const visual = getChipVisual(label);
const accent = visual?.accent ?? '#94a3b8';

---

<span class="meta-chip" style={`--chip-accent: ${accent}`}>
  {visual && (
    <span class:list={['meta-chip__mark', visual.kind === 'image' && 'meta-chip__mark--photo']}>
      {visual.kind === 'svg' ? (
        <visual.Icon width="17" height="17" />
      ) : (
        <Image src={visual.src} alt="" width={17} height={17} />
      )}
    </span>
  )}
  <span class="meta-chip__label">{label}</span>
</span>

