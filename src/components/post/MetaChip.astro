---
import { Image } from 'astro:assets'
import Choose from '@components/Choose.astro'
import { chipView } from '@data/chipIcons'
import type { MetaChipProps as Props } from '@types'
import '@styles/post/MetaChip.css'

const { label } = Astro.props

const { accent, svg: SvgIcon, photo } = chipView(label)
---

<span class="meta-chip" style={`--chip-accent: ${accent}`}>
  <Choose if={!!SvgIcon}>
    <span slot="then" class="meta-chip__mark">
      {SvgIcon && <SvgIcon width="17" height="17" />}
    </span>
  </Choose>
  <Choose if={!!photo}>
    <span slot="then" class:list={['meta-chip__mark', 'meta-chip__mark--photo']}>
      {photo && <Image src={photo} alt="" width={17} height={17} />}
    </span>
  </Choose>
  <span class="meta-chip__label">{label}</span>
</span>
