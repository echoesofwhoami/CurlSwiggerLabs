---
import { formatDate, getPostSlug, siteBase } from '../../utils'
import type { RelatedLabsProps as Props } from '@types'
import '@styles/post/RelatedLabs.css'

const { posts } = Astro.props
const base = siteBase();

---

{posts.length > 0 && (
  <section class="related-labs" aria-labelledby="related-labs-title">
    <h2 id="related-labs-title">Related labs</h2>
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`${base}/${getPostSlug(post.id)}`}>
            <strong>{post.data.title}</strong>
            <span>{post.data.difficulty} · {formatDate(post.data.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

