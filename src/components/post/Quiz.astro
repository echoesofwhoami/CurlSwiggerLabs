---
import { loadQuiz } from '@data/quiz'
import type { QuizProps as Props } from '@types'
import Choose from '@components/Choose.astro'
import '@styles/post/Quiz.css'

const { file, slug } = Astro.props

const quiz = await loadQuiz(file)
---

<Choose if={quiz.count > 0}>
  <section
    slot="then"
    class="quiz"
    data-controller="quiz"
    data-quiz-slug-value={slug}
    data-quiz-questions-value={quiz.questions}
  >
    <header class="quiz-header">
      <h2 class="quiz-title">
        <svg class="quiz-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="10" cy="10" r="8.5"/>
          <path d="M7.5 7.5a2.5 2.5 0 0 1 4.9.8c0 1.7-2.4 2.2-2.4 3.7" stroke-linecap="round"/>
          <circle cx="10" cy="14.5" r=".75" fill="currentColor" stroke="none"/>
        </svg>
        Knowledge Check
      </h2>
      <span class="quiz-meta">{quiz.count}&nbsp;questions</span>
    </header>

    <div class="quiz-inner" data-quiz-target="stage" aria-live="polite"></div>

    <template data-quiz-target="question">
      <div class="quiz-progress">
        <span class="quiz-progress-label"><span data-quiz-part="label"></span> <strong data-quiz-part="current"></strong> <span data-quiz-part="of"></span> <span data-quiz-part="total"></span></span>
        <div class="quiz-progress-track" role="progressbar">
          <div class="quiz-progress-fill"></div>
        </div>
      </div>
      <div class="quiz-question-area" data-quiz-part="body">
        <p class="quiz-q"><strong class="quiz-num" data-quiz-part="number"></strong> <span data-quiz-part="prompt"></span></p>
        <ul class="quiz-opts" role="list" data-quiz-part="options"></ul>
      </div>
      <div class="quiz-feedback" hidden>
        <p class="quiz-fb-label"></p>
        <p class="quiz-fb-text"></p>
        <button class="quiz-next" type="button" data-action="click->quiz#advance" data-quiz-part="next"></button>
      </div>
    </template>

    <template data-quiz-target="option">
      <li>
        <button class="quiz-opt" type="button" data-action="click->quiz#choose">
          <span class="quiz-opt-letter" data-quiz-part="letter"></span>
          <span class="quiz-opt-text" data-quiz-part="text"></span>
        </button>
      </li>
    </template>

    <template data-quiz-target="hint">
      <div class="quiz-hint-area">
        <button class="quiz-hint-btn" type="button" data-action="click->quiz#revealHint" data-quiz-part="hint-label"></button>
        <p class="quiz-hint-text" data-quiz-part="hint-text" hidden></p>
      </div>
    </template>

    <template data-quiz-target="summary">
      <div class="quiz-summary">
        <div class="quiz-score-display">
          <span class="quiz-score-num" data-quiz-part="score"></span>
          <span class="quiz-score-sep"> / </span>
          <span class="quiz-score-denom" data-quiz-part="total"></span>
        </div>
        <p class="quiz-score-text"><span data-quiz-part="scored"></span> <strong data-quiz-part="fraction"></strong> <span data-quiz-part="correct"></span></p>
        <div class="quiz-score-bar-wrap" aria-hidden="true">
          <div class="quiz-score-bar"></div>
        </div>
        <button class="quiz-retake" type="button" data-action="click->quiz#retake"></button>
      </div>
    </template>
  </section>
</Choose>
