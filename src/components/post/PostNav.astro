---
import { getPostSlug, siteBase } from '../../utils'
import type { PostNavProps as Props } from '@types'
import '@styles/post/PostNav.css'

const { older, newer } = Astro.props
const base = siteBase();

---

{(older || newer) && (
  <nav class="post-nav" aria-label="Lab navigation">
    {older ? (
      <a class="post-nav-link older" href={`${base}/${getPostSlug(older.id)}`}>
        <span>Older lab</span>
        <strong>{older.data.title}</strong>
      </a>
    ) : <span />}
    {newer && (
      <a class="post-nav-link newer" href={`${base}/${getPostSlug(newer.id)}`}>
        <span>Newer lab</span>
        <strong>{newer.data.title}</strong>
      </a>
    )}
  </nav>
)}

