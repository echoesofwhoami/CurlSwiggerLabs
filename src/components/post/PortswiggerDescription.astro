---
const description = Astro.locals.portswiggerDescription;
---

{description && (
  <details class="compact-collapsible">
    <summary>
      <span class="compact-collapsible-title">PortSwigger's original description</span>
      <span class="expand-hint">click to expand</span>
    </summary>
    <div class="compact-collapsible-content">
      <p>{description}</p>
    </div>
  </details>
)}
