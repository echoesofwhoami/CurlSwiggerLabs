---
import { Image } from 'astro:assets'
import { formatDate, postHeaderView } from '@utils'
import psLogo from '@assets/ps_logo.png'
import ExternalLink from '@components/mdx/ExternalLink.astro'
import Choose from '@components/Choose.astro'
import MetaChip from '@components/post/MetaChip.astro'
import type { PostHeaderProps as Props } from '@types'
import '@styles/post/PostHeader.css'

const {
  title,
  category,
  labUrl,
  date,
  difficulty,
  tools,
} = Astro.props

const { technologies, seriesName, paragraphs, difficultyClass } = postHeaderView(Astro.props)
---

<header class="post-header">
  <h1>{title}</h1>
  <p class="post-source">
    <strong>{category}</strong>
    <span aria-hidden="true">·</span>

    <ExternalLink text="Portswigger Lab Link" url={labUrl} class="portswigger-color">
      <Image src={psLogo} alt="portswigger logo" width={18} height={18} />
    </ExternalLink>
  </p>
  <div class="post-metadata">
    <span>
      <strong>Difficulty</strong>
      <span class:list={['difficulty-chip', difficultyClass]}>
        <span class="difficulty-chip__spacer" aria-hidden="true"></span>
        {difficulty}
      </span>
    </span>
    <span>
      <strong>Tools</strong>
      <span class="chip-list">
        {tools.map((tool) => <MetaChip label={tool} />)}
      </span>
    </span>
    <Choose if={technologies.length > 0}>
      <span slot="then">
        <strong>Technologies</strong>
        <span class="chip-list">
          {technologies.map((tech) => <MetaChip label={tech} />)}
        </span>
      </span>
    </Choose>
    <Choose if={!!seriesName}>
      <span slot="then"><strong>Series</strong> {seriesName}</span>
    </Choose>
  </div>
  <div class="post-description">
    {paragraphs.map((line) => (
      <p class:list={{ 'post-description-hook': line.hook }}>{line.text}</p>
    ))}
  </div>
  <small>{formatDate(date)}</small>
</header>
