---
import { Image } from 'astro:assets'
import { formatDate } from '../../utils'
import psLogo from '../../assets/ps_logo.png'
import ExternalLink from '../mdx/ExternalLink.astro'
import MetaChip from './MetaChip.astro'
import type { PostHeaderProps as Props } from '@types'
import '@styles/post/PostHeader.css'

const {
  title,
  description,
  category,
  labUrl,
  date,
  difficulty,
  tools,
  technologies = [],
  series,
} = Astro.props
const seriesName = series?.replaceAll('-', ' ')
const descriptionLines = description
  .split(/\n+/)
  .map((line) => line.trim())
  .filter(Boolean)
const difficultyClass = `difficulty-chip--${difficulty.toLowerCase()}`;

---

<header class="post-header">
  <h1>{title}</h1>
  <p class="post-source">
    <strong>{category}</strong>
    <span aria-hidden="true">·</span>

    <ExternalLink text="Portswigger Lab Link" url={labUrl} class="portswigger-color">
      <Image src={psLogo} alt="portswigger logo" width={18} height={18} />
    </ExternalLink>
  </p>
  <div class="post-metadata">
    <span>
      <strong>Difficulty</strong>
      <span class:list={['difficulty-chip', difficultyClass]}>
        <span class="difficulty-chip__spacer" aria-hidden="true"></span>
        {difficulty}
      </span>
    </span>
    <span>
      <strong>Tools</strong>
      <span class="chip-list">
        {tools.map((tool) => <MetaChip label={tool} />)}
      </span>
    </span>
    {technologies.length > 0 && (
      <span>
        <strong>Technologies</strong>
        <span class="chip-list">
          {technologies.map((tech) => <MetaChip label={tech} />)}
        </span>
      </span>
    )}
    {seriesName && <span><strong>Series</strong> {seriesName}</span>}
  </div>
  <div class="post-description">
    {descriptionLines.map((line, index) => (
      <p class:list={[index === descriptionLines.length - 1 && descriptionLines.length > 1 && 'post-description-hook']}>
        {line}
      </p>
    ))}
  </div>
  <small>{formatDate(date)}</small>
</header>

