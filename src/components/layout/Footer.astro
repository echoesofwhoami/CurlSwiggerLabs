---
import ExternalLinkSvg from '@assets/external_link.svg'
import ExternalLink from '@components/mdx/ExternalLink.astro'
import psLogo from '@assets/ps_logo.png'
import { Image } from 'astro:assets'
import { footerLinks } from '@utils'
import Choose from '@components/Choose.astro'
import '@styles/layout/Footer.css'

const { homeHref, explore, resources, social, discordInvite, discordHandle, year } = footerLinks()
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand__link" href={homeHref}>
          <img src="/echoes.png" alt="" width="32" height="32" />
          <span>Curl<span>Swigger</span>Labs</span>
        </a>
        <p>Clear, detailed PortSwigger lab writeups built around curl, scripts, and raw HTTP.</p>
        <p>

        </p>
        <p class="footer-credit">
          Thanks to
          <ExternalLink text="PortSwigger" url="https://portswigger.net/web-security" class="portswigger-color">
            <Image class="ps-logo" src={psLogo} alt="portswigger logo" width={18} height={18} />
          </ExternalLink>
          for providing the Web Security Academy labs that make these writeups possible.
        </p>
      </div>

      <nav class="footer-group" aria-labelledby="footer-explore">
        <h2 id="footer-explore">Explore</h2>
        <ul>
          {explore.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-group" aria-labelledby="footer-resources">
        <h2 id="footer-resources">Resources</h2>
        <ul>
          {
            resources.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={link.rel}
                  class:list={{ 'external-link': link.external }}
                >
                  {link.label}
                  <Choose if={link.external}>
                    <ExternalLinkSvg slot="then" />
                  </Choose>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-group" aria-labelledby="footer-connect">
        <h2 id="footer-connect">Connect</h2>
        <ul>
          <li>
            <Choose if={discordInvite.length > 0}>
              <a slot="then" href={discordInvite} target="_blank" rel="noreferrer">
                Discord <ExternalLinkSvg />
              </a>
              <span slot="else" class="footer-discord">
                Discord · {discordHandle}
              </span>
            </Choose>
          </li>
          {
            social.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={link.rel}
                  class:list={{ 'external-link': link.external }}
                >
                  {link.label}
                  <Choose if={link.external}>
                    <ExternalLinkSvg slot="then" />
                  </Choose>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© {year} CurlSwiggerLabs</span>
      <span>HTTP in. Understanding out.</span>
    </div>
  </div>
</footer>
