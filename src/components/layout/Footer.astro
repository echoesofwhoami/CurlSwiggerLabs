---
import { siteConfig } from '../../site.config';
import ExternalLinkSvg from '../../assets/external_link.svg';
import ExternalLink from '../mdx/ExternalLink.astro';
import psLogo from '../../assets/ps_logo.png';
import { Image } from 'astro:assets';
import { siteBase } from '../../utils';
import '@styles/layout/Footer.css';

const base = siteBase();
const year = new Date().getFullYear();

const siteLinks = [
  { label: 'Home', href: `${base}/` },
  { label: 'About', href: `${base}/about` },
  { label: 'Background Concepts', href: `${base}/background-concepts` },
  { label: "I don't like this website", href: `${base}/i-dont-like-this-website` },
];
const resourceLinks = [
  {
    label: 'RSS',
    href: `${base}${siteConfig.rssPath}`,
    external: false,
  },
  {
    label: 'Blog source',
    href: siteConfig.blogSourceUrl.trim(),
    external: true,
  },
].filter((link) => link.href.length > 0);
const socialLinks = [
  {
    label: 'GitHub',
    href: siteConfig.githubProfileUrl.trim(),
    external: true,
  },
  {
    label: 'LinkedIn',
    href: siteConfig.linkedinUrl.trim(),
    external: true,
  },
].filter((link) => link.href.length > 0);

---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-brand__link" href={`${base}/`}>
          <img src="/echoes.png" alt="" width="32" height="32" />
          <span>Curl<span>Swigger</span>Labs</span>
        </a>
        <p>Clear, detailed PortSwigger lab writeups built around curl, scripts, and raw HTTP.</p>
        <p>

        </p>
        <p class="footer-credit">
          Thanks to{' '}
          <ExternalLink text="PortSwigger" url="https://portswigger.net/web-security" class="portswigger-color">
            <Image class="ps-logo" src={psLogo} alt="portswigger logo" width={18} height={18} />
          </ExternalLink>
          {' '}for providing the Web Security Academy labs that make these writeups possible.
        </p>
      </div>

      <nav class="footer-group" aria-labelledby="footer-explore">
        <h2 id="footer-explore">Explore</h2>
        <ul>
          {siteLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-group" aria-labelledby="footer-resources">
        <h2 id="footer-resources">Resources</h2>
        <ul>
          {
            resourceLinks.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noreferrer' : undefined}
                  class={external ? 'external-link' : ''}
                >
                  {label} {external && <ExternalLinkSvg />}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="footer-group" aria-labelledby="footer-connect">
        <h2 id="footer-connect">Connect</h2>
        <ul>
          <li>
            {siteConfig.discordInviteUrl.trim() ? (
              <a href={siteConfig.discordInviteUrl} target="_blank" rel="noreferrer">
                Discord <ExternalLinkSvg />
              </a>
            ) : (
              <span class="footer-discord">
                Discord · {siteConfig.discordHandle}
              </span>
            )}
          </li>
          {
            socialLinks.map(({ label, href, external }) => (
              <li>
                <a
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noreferrer' : undefined}
                  class={external ? 'external-link' : ''}
                >
                  {label} {external && <ExternalLinkSvg />}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>© {year} CurlSwiggerLabs</span>
      <span>HTTP in. Understanding out.</span>
    </div>
  </div>
</footer>

