<div
  data-copy-code
  data-copy-label="Copy"
  data-copied-label="Copied!"
  hidden
></div>

<script>
function copyEventHandler() {
  const host = document.querySelector<HTMLElement>('[data-copy-code]')
  if (!host) return

  const copyLabel = host.dataset.copyLabel ?? 'Copy'
  const copiedLabel = host.dataset.copiedLabel ?? 'Copied!'
  const codeBlocks = Array.from(document.querySelectorAll<HTMLPreElement>('pre'))

  for (const codeBlock of codeBlocks) {
    if (codeBlock.parentElement?.classList.contains('code-wrapper')) continue
    if (codeBlock.closest('.request-diff')) continue

    const wrapper = document.createElement('div')
    wrapper.className = 'code-wrapper'

    const copyButton = document.createElement('button')
    copyButton.type = 'button'
    copyButton.className = 'copy-code'
    copyButton.innerText = copyLabel
    copyButton.setAttribute('aria-label', copyLabel)

    codeBlock.setAttribute('tabindex', '0')
    if (codeBlock.parentNode) {
      codeBlock.parentNode.insertBefore(wrapper, codeBlock)
    }
    wrapper.appendChild(codeBlock)
    wrapper.appendChild(copyButton)

    copyButton.addEventListener('click', async () => {
      await copyCode(codeBlock, copyButton, copyLabel, copiedLabel)
    })
  }
}
async function copyCode(
  block: HTMLPreElement,
  button: HTMLButtonElement,
  copyLabel: string,
  copiedLabel: string,
) {
  const code = block.querySelector('code')
  const text = code?.textContent ?? block.textContent

  await navigator.clipboard.writeText(text)
  button.innerText = copiedLabel
  button.setAttribute('aria-label', copiedLabel)

  setTimeout(() => {
    button.innerText = copyLabel
    button.setAttribute('aria-label', copyLabel)
  }, 700)
}
copyEventHandler()
</script>
