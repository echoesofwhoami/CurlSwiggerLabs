---
import { clientGlossary } from '@data/glossary'

const glossaryJson = clientGlossary()
---

<script type="application/json" data-tooltip-target="glossary" is:inline set:html={glossaryJson}></script>

<div
  id="csl-tip-popover"
  hidden
  role="tooltip"
  data-tooltip-target="panel"
  data-action="mouseenter->tooltip#hold mouseleave->tooltip#release"
>
  <p data-tooltip-target="term"></p>
  <p data-tooltip-target="short"></p>
  <div data-tooltip-target="code" hidden></div>
  <div data-tooltip-target="links"></div>
</div>

<template data-tooltip-target="link">
  <a target="_blank" rel="noopener noreferrer"></a>
</template>
