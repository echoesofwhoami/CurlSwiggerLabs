---
import { loadRequestDiff } from '@utils/request-diff'
import { slugifyId } from '@utils'
import { tooltipActions } from '../../shiki/tooltip-transformer'
import type { RequestDiffProps as Props } from '@types'
import Choose from '@components/Choose.astro'
import '@styles/mdx/RequestDiff.css'

const { left, right, leftLabel, rightLabel } = Astro.props

const diff = loadRequestDiff({
  left,
  right,
  leftLabel,
  rightLabel,
  tipAction: tooltipActions,
  slugify: slugifyId,
})
---

<div
  class:list={['request-diff', { 'is-json': diff.jsonMode, 'is-http': diff.httpMode }]}
  data-controller="request-diff"
  data-diff={diff.diffId}
  role="region"
  aria-label="Request diff"
>
  <textarea class="request-diff-source" data-request-diff-target="source" data-side="left" readonly hidden>{diff.leftRaw}</textarea>
  <textarea class="request-diff-source" data-request-diff-target="source" data-side="right" readonly hidden>{diff.rightRaw}</textarea>

  <div class="request-diff-split">
    <div class="request-diff-toolbar">
      {diff.sides.map((side) => (
        <div class="request-diff-heading">
          <span class:list={['request-diff-label', side.labelClass]}>
            {side.title}
          </span>
          <button
            type="button"
            class="copy-code request-diff-copy"
            data-action="click->request-diff#copy"
            data-request-diff-side-param={side.id}
          >
            <span class="request-diff-copy-label" data-request-diff-target="copyLabel">Copy</span>
          </button>
        </div>
      ))}
    </div>
    <div class="request-diff-split-body">
      {diff.sides.map((side) => (
        <div class:list={['request-diff-cell', side.id]}>
          <Choose if={side.segments.length > 0}>
            <div slot="then" class="request-diff-single-line request-diff-jwt">
              {side.segments.map((seg) => (
                <span
                  class:list={['jwt-piece', { tip: seg.hoverable, 'tip--syntax': seg.hoverable }]}
                  data-tip-term={seg.term}
                  data-tip-decode={seg.decode}
                  data-tip-short={seg.short}
                  role={seg.role}
                  tabindex={seg.tabindex}
                  aria-expanded={seg.expanded}
                  data-action={seg.action}
                >
                  <span class:list={['jwt-seg', seg.mark]}>{seg.text}</span>
                  <Choose if={seg.dot}>
                    <span slot="then" class="jwt-dot">.</span>
                  </Choose>
                </span>
              ))}
            </div>
          </Choose>
          {side.lines.map((line) => (
            <div class:list={['request-diff-single-line', line.kind]}>
              {line.parts.map((part) => (
                <span class:list={[part.type, { ph: part.placeholder }]}>{part.text}</span>
              ))}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="request-diff-mobile" data-active={diff.activePanel} data-request-diff-target="mobile">
    <div class="request-diff-tabs" role="tablist" aria-label="Request diff">
      {diff.sides.map((side) => (
        <button
          class:list={['request-diff-tab', { 'is-active': side.active }]}
          type="button"
          role="tab"
          aria-selected={side.selected}
          data-panel={side.id}
          data-request-diff-target="tab"
          data-action="click->request-diff#select"
          data-request-diff-panel-param={side.id}
        >
          <span class:list={['request-diff-swatch', side.swatchClass]} aria-hidden="true"></span>
          <span>{side.title}</span>
        </button>
      ))}
    </div>
    <div class="request-diff-panel-wrap">
      <button
        type="button"
        class="copy-code request-diff-copy"
        data-request-diff-target="mobileCopy"
        data-action="click->request-diff#copy"
        data-request-diff-side-param={diff.activePanel}
      >
        <span class="request-diff-copy-label" data-request-diff-target="copyLabel">Copy</span>
      </button>
      {diff.sides.map((side) => (
        <div
          class="request-diff-panel"
          data-panel={side.id}
          data-request-diff-target="panel"
          hidden={side.hidden}
        >
          <div class="request-diff-body">
            <Choose if={side.segments.length > 0}>
              <div slot="then" class="request-diff-single-line request-diff-jwt">
                {side.segments.map((seg) => (
                  <span
                    class:list={['jwt-piece', { tip: seg.hoverable, 'tip--syntax': seg.hoverable }]}
                    data-tip-term={seg.term}
                    data-tip-decode={seg.decode}
                    data-tip-short={seg.short}
                    role={seg.role}
                    tabindex={seg.tabindex}
                    aria-expanded={seg.expanded}
                    data-action={seg.action}
                  >
                    <span class:list={['jwt-seg', seg.mark]}>{seg.text}</span>
                    <Choose if={seg.dot}>
                      <span slot="then" class="jwt-dot">.</span>
                    </Choose>
                  </span>
                ))}
              </div>
            </Choose>
            {side.lines.map((line) => (
              <div class:list={['request-diff-single-line', line.kind]}>
                {line.parts.map((part) => (
                  <span class:list={[part.type, { ph: part.placeholder }]}>{part.text}</span>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
