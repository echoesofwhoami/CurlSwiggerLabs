---
import { render } from 'astro:content'
import Term from '@components/mdx/Term.astro'
import RequestDiff from '@components/mdx/RequestDiff.astro'
import type { CompactCollapsiblePartialProps as Props } from '@types'
import { requirePartial } from '@utils/partials'

const { partial, title, collection } = Astro.props

Astro.locals.usedTips ??= new Set<string>()

const entry = await requirePartial(partial, collection)

const { Content } = await render(entry)
---

<details class="compact-collapsible">
  <summary>
    <span class="compact-collapsible-title">{title}</span>
    <span class="expand-hint">click to expand</span>
  </summary>
  <div class="compact-collapsible-content">
    <Content components={{ Term, RequestDiff }} />
  </div>
</details>
