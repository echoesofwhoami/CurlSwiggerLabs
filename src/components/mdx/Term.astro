---
import { termView } from '@data/glossary'
import { tooltipActions } from '../../shiki/tooltip-transformer'
import type { TermProps as Props } from '@types'
import Choose from '@components/Choose.astro'

const { id } = Astro.props

const hasSlot = Astro.slots.has('default')

const { entry, label, kindClass } = termView(id, Astro.locals)
---

<Choose if={!!entry}>
  <button
    slot="then"
    type="button"
    class:list={['tip', kindClass]}
    data-tip-id={id}
    aria-expanded="false"
    data-action={tooltipActions}
  >
    <Choose if={hasSlot}>
      <slot slot="then" />
      <span slot="else">{label}</span>
    </Choose>
  </button>
  <Choose slot="else" if={hasSlot}>
    <slot slot="then" />
    <span slot="else">{id}</span>
  </Choose>
</Choose>
