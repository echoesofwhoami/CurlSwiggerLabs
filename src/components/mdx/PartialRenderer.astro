---
import { getEntry, render } from 'astro:content';
import Term from './Term.astro';
import RequestDiff from './RequestDiff.astro';

interface Props {
  partial: string;
}

const { partial } = Astro.props;

Astro.locals.postLang ??= 'en';
Astro.locals.usedTips ??= new Set<string>();

const entry = await getEntry('partials', partial);

if (!entry) throw new Error(`Partial not found: ${partial}`);

const { Content } = await render(entry);
---

<Content components={{ Term, RequestDiff }} />
