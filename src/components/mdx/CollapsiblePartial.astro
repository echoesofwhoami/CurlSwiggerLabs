---
import { getEntry, render } from 'astro:content';
import Quiz from '../post/Quiz.astro';
import Term from './Term.astro';
import RequestDiff from './RequestDiff.astro';
import type { CollapsiblePartialProps as Props } from '@types';

const { partial, title } = Astro.props;

Astro.locals.usedTips ??= new Set<string>();

const entry = await getEntry('partials', partial);

if (!entry) throw new Error(`Partial not found: ${partial} in partials`);

const { Content } = await render(entry);
---

<details class="collapsible-partial">
  <summary>
    <span class="partial-summary-text">
      <span class="partial-title">{title}</span>
      <span class="expand-hint">click to expand</span>
    </span>
  </summary>
  <div class="partial-content">
    <Content components={{ Term, RequestDiff }} />
  </div>
  <Quiz file={`concepts/${partial}`} slug={`concept-${partial}`} />
</details>
