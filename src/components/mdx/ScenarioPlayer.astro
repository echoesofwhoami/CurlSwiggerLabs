---
import CodeSnippet from './CodeSnippet.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { CLOBBER_PRESETS, LAB_PAYLOAD } from '../../lib/dom-clobbering-scenario';

interface Props {
  scenario: 'dom-clobbering';
}

const { scenario } = Astro.props;
const postLang = (Astro.locals.postLang ?? 'en') as Lang;
const t = useTranslations(postLang);
---

<section
  class="scenario-player"
  data-scenario={scenario}
  data-t-step={t('scenario.step')}
  data-t-of={t('scenario.of')}
  data-t-would-fire={t('scenario.wouldFire')}
  data-t-next={t('scenario.next')}
  data-t-start-over={t('scenario.startOver')}
  role="region"
  aria-label={t('scenario.engine')}
>
  <div class="sp-chrome">
    <header class="sp-header">
      <!-- <div class="sp-engine"> -->
        <!-- <span class="sp-engine-label">{t('scenario.engine')}</span> -->
      <!-- </div> -->
      <div class="sp-controls">
        <button type="button" class="sp-btn" data-sp-restart data-sp-restart-chrome>{t('scenario.restart')}</button>
        <button type="button" class="sp-btn" data-sp-prev>{t('scenario.prev')}</button>
        <button type="button" class="sp-btn sp-btn-next" data-sp-next>{t('scenario.next')}</button>
        <p class="sp-step-meta" data-sp-meta></p>
      </div>
      <div class="sp-dots" data-sp-dots role="tablist" aria-label={t('scenario.steps')}></div>
    </header>

    <p class="sp-title" data-sp-title></p>
    <p class="sp-loop" data-sp-loop hidden></p>
    <p class="sp-narration" data-sp-narration aria-live="polite"></p>
  </div>

  <div class="sp-grid">
    <div class="sp-left" data-sp-left>
      <div class="sp-panel is-active" data-sp-panel="script">
        <CodeSnippet file="exploiting-dom-clobbering-to-enable-xss/original-vulnerable.js" />
      </div>
      <div class="sp-panel" data-sp-panel="http" hidden>
        <div class="sp-http">
          <div class="sp-http-col" data-sp-request-col>
            <p class="sp-http-label">{t('scenario.request')}</p>
            <pre class="scenario-pre" data-language="http" tabindex="0"><code data-sp-request></code></pre>
          </div>
          <div class="sp-http-col" data-sp-response-col>
            <p class="sp-http-label">{t('scenario.response')}</p>
            <pre class="scenario-pre" data-language="http" tabindex="0"><code data-sp-response-headers></code></pre>
            <pre class="scenario-pre" data-sp-response-body-pre tabindex="0"><code data-sp-response-body></code></pre>
          </div>
        </div>
      </div>
    </div>

    <div class="sp-right" data-sp-right>
      <p class="sp-fire" data-sp-fire hidden></p>
      <div class="sp-block sp-binds" data-sp-watches-wrap hidden>
        <h4 class="sp-block-title">{t('scenario.watches')}</h4>
        <div class="sp-bind-list" data-sp-watches></div>
      </div>
      <div class="sp-page" data-sp-page-wrap hidden>
        <div class="sp-page-label-row">
          <p class="sp-http-label">{t('scenario.dom')}</p>
          <div class="sp-tabs sp-mini-tabs" role="tablist" aria-label={t('scenario.domViews')}>
            <button type="button" class="sp-tab is-active" data-sp-page-view="html">{t('scenario.domHtml')}</button>
            <button type="button" class="sp-tab" data-sp-page-view="tree">{t('scenario.domTree')}</button>
          </div>
        </div>
        <div class="sp-page-panel" data-sp-page-panel="tree" hidden>
          <div class="sp-dom" data-sp-dom></div>
        </div>
        <div class="sp-page-panel is-active" data-sp-page-panel="html">
          <pre class="scenario-pre sp-page-pre" data-language="html" tabindex="0"><code data-sp-page-html></code></pre>
        </div>
        <p class="sp-page-note" data-sp-page-note hidden></p>
      </div>
      <div class="sp-block" data-sp-pending-wrap hidden>
        <h4 class="sp-block-title">{t('scenario.pendingDom')}</h4>
        <div class="sp-dom" data-sp-pending></div>
      </div>
      <div class="sp-block" data-sp-sink-wrap hidden>
        <h4 class="sp-block-title">{t('scenario.sink')}</h4>
        <pre class="sp-sink-pre"><code data-sp-sink></code></pre>
      </div>
      <p class="sp-firefox" data-sp-firefox hidden></p>
    </div>
  </div>

  <div class="sp-summary" data-sp-summary hidden>
    <p class="sp-summary-text" data-sp-summary-text></p>
    <button type="button" class="sp-btn sp-btn-next" data-sp-restart>{t('scenario.startOver')}</button>
  </div>

  <details class="sp-editor">
    <summary class="sp-editor-summary">{t('scenario.payload')}</summary>
    <div class="sp-editor-head">
      <div class="sp-presets" role="group" aria-label={t('scenario.presets')}>
        {CLOBBER_PRESETS.map((preset) => (
          <button
            type="button"
            class:list={['sp-preset', { 'is-active': preset.id === 'lab' }]}
            data-sp-preset={preset.id}
            title={preset.hint}
          >{preset.label}</button>
        ))}
      </div>
    </div>
    <label class="sp-label" for="sp-payload">{t('scenario.payloadHtml')}</label>
    <textarea id="sp-payload" class="sp-textarea" data-sp-payload rows="3" spellcheck="false">{LAB_PAYLOAD}</textarea>
    <label class="sp-check">
      <input type="checkbox" data-sp-trigger checked />
      {t('scenario.trigger')}
    </label>
    <div class="sp-editor-actions">
      <button type="button" class="sp-btn sp-btn-apply" data-sp-apply>{t('scenario.apply')}</button>
      <button type="button" class="sp-btn" data-sp-reset>{t('scenario.reset')}</button>
    </div>
  </details>
</section>

<script>
  import {
    buildDomClobberingSteps,
    CLOBBER_PRESETS,
    LAB_PAYLOAD,
    type PaneId,
    type ScenarioStep,
  } from '../../lib/dom-clobbering-scenario';
  import type { DomView } from '../../lib/chromium-clobber';
  import { renderHighlighted, splitHttpMessage, tokenize } from '../../lib/code-highlight';
  import type { Token } from '../../lib/code-highlight';

  function renderPageSource(target: HTMLElement, code: string, mark: string): HTMLElement | null {
    target.replaceChildren();
    let firstHit: HTMLElement | null = null;
    let row = document.createElement('span');
    row.className = 'sp-html-line';
    let lineText = '';

    const flush = (trailingNl: boolean): void => {
      if (mark && lineText.includes(mark)) {
        row.classList.add('is-current');
        if (!firstHit) firstHit = row;
      }
      if (trailingNl) row.append('\n');
      target.appendChild(row);
    };

    const appendPart = (text: string, kind?: Token['kind']): void => {
      if (!text) return;
      if (!kind) {
        row.append(text);
        return;
      }
      const span = document.createElement('span');
      span.className = `tok-${kind}`;
      span.textContent = text;
      row.appendChild(span);
    };

    for (const token of tokenize(code, 'html')) {
      const parts = token.text.split('\n');
      parts.forEach((part, i) => {
        if (i > 0) {
          flush(true);
          row = document.createElement('span');
          row.className = 'sp-html-line';
          lineText = '';
        }
        appendPart(part, token.kind);
        lineText += part;
      });
    }
    flush(false);
    return firstHit;
  }

  function scrollIntoScroller(scroller: HTMLElement, target: HTMLElement | null): void {
    if (!target) return;
    const sRect = scroller.getBoundingClientRect();
    const tRect = target.getBoundingClientRect();
    const top = tRect.top - sRect.top + scroller.scrollTop - scroller.clientHeight / 2 + tRect.height / 2;
    scroller.scrollTop = Math.max(0, top);
  }

  function renderDom(node: DomView): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'sp-dom-node';
    if (node.pending) wrap.classList.add('is-pending');
    if (node.highlight) {
      if (node.tag === 'script') wrap.classList.add('is-script');
      else if (node.extra?.includes('onerror=')) wrap.classList.add('is-sink');
      else wrap.classList.add('is-clobber');
    }

    const tag = document.createElement('span');
    tag.className = 'sp-dom-tag';
    const bits = [node.tag];
    if (node.id) bits.push(`#${node.id}`);
    if (node.name) bits.push(`[name=${node.name}]`);
    if (node.href) bits.push(`[href=${node.href}]`);
    if (node.extra) bits.push(node.extra);
    tag.textContent = bits.join(' ');
    wrap.appendChild(tag);

    if (node.children.length > 0) {
      const list = document.createElement('div');
      list.className = 'sp-dom-kids';
      for (const child of node.children) list.appendChild(renderDom(child));
      wrap.appendChild(list);
    }
    return wrap;
  }

  function initPlayer(root: HTMLElement): void {
    if (root.dataset.spInit === '1') return;
    root.dataset.spInit = '1';
    if (root.dataset.scenario !== 'dom-clobbering') return;

    const titleEl = root.querySelector<HTMLElement>('[data-sp-title]')!;
    const loopEl = root.querySelector<HTMLElement>('[data-sp-loop]')!;
    const narrationEl = root.querySelector<HTMLElement>('[data-sp-narration]')!;
    const metaEl = root.querySelector<HTMLElement>('[data-sp-meta]')!;
    const dotsEl = root.querySelector<HTMLElement>('[data-sp-dots]')!;
    const watchesWrap = root.querySelector<HTMLElement>('[data-sp-watches-wrap]')!;
    const watchesEl = root.querySelector<HTMLElement>('[data-sp-watches]')!;
    const leftEl = root.querySelector<HTMLElement>('[data-sp-left]')!;
    const rightEl = root.querySelector<HTMLElement>('[data-sp-right]')!;
    const gridEl = root.querySelector<HTMLElement>('.sp-grid')!;
    const pageWrap = root.querySelector<HTMLElement>('[data-sp-page-wrap]')!;
    const pageHtmlEl = root.querySelector<HTMLElement>('[data-sp-page-html]')!;
    const domEl = root.querySelector<HTMLElement>('[data-sp-dom]')!;
    const pendingWrap = root.querySelector<HTMLElement>('[data-sp-pending-wrap]')!;
    const pendingEl = root.querySelector<HTMLElement>('[data-sp-pending]')!;
    const pageNoteEl = root.querySelector<HTMLElement>('[data-sp-page-note]')!;
    const fireEl = root.querySelector<HTMLElement>('[data-sp-fire]')!;
    const firefoxEl = root.querySelector<HTMLElement>('[data-sp-firefox]')!;
    const sinkWrap = root.querySelector<HTMLElement>('[data-sp-sink-wrap]')!;
    const sinkEl = root.querySelector<HTMLElement>('[data-sp-sink]')!;
    const summaryEl = root.querySelector<HTMLElement>('[data-sp-summary]')!;
    const summaryTextEl = root.querySelector<HTMLElement>('[data-sp-summary-text]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-sp-next]')!;
    const requestEl = root.querySelector<HTMLElement>('[data-sp-request]')!;
    const responseHeadersEl = root.querySelector<HTMLElement>('[data-sp-response-headers]')!;
    const responseBodyEl = root.querySelector<HTMLElement>('[data-sp-response-body]')!;
    const responseBodyPre = root.querySelector<HTMLElement>('[data-sp-response-body-pre]')!;
    const requestCol = root.querySelector<HTMLElement>('[data-sp-request-col]')!;
    const responseCol = root.querySelector<HTMLElement>('[data-sp-response-col]')!;
    const httpWrap = root.querySelector<HTMLElement>('.sp-http')!;
    const payloadEl = root.querySelector<HTMLTextAreaElement>('[data-sp-payload]')!;
    const triggerEl = root.querySelector<HTMLInputElement>('[data-sp-trigger]')!;
    const editorEl = root.querySelector<HTMLDetailsElement>('.sp-editor')!;
    const chromeRestart = root.querySelector<HTMLButtonElement>('[data-sp-restart-chrome]');
    const tStep = root.dataset.tStep ?? 'Step';
    const tOf = root.dataset.tOf ?? 'of';
    const tWouldFire = root.dataset.tWouldFire ?? 'Would execute';
    const tNext = root.dataset.tNext ?? 'Next';
    const tStartOver = root.dataset.tStartOver ?? 'Start over';

    let payload = LAB_PAYLOAD;
    let trigger = true;
    let carlos = true;
    let steps: ScenarioStep[] = [];
    let index = 0;
    let pageView: 'tree' | 'html' = 'html';

    function setPageView(view: 'tree' | 'html'): void {
      pageView = view;
      root.querySelectorAll<HTMLElement>('[data-sp-page-view]').forEach((tab) => {
        tab.classList.toggle('is-active', tab.dataset.spPageView === view);
      });
      root.querySelectorAll<HTMLElement>('[data-sp-page-panel]').forEach((panel) => {
        const on = panel.dataset.spPagePanel === view;
        panel.classList.toggle('is-active', on);
        panel.toggleAttribute('hidden', !on);
      });
    }

    function setPane(pane: PaneId): void {
      root.querySelectorAll<HTMLElement>('[data-sp-pane]').forEach((tab) => {
        tab.classList.toggle('is-active', tab.dataset.spPane === pane);
      });
      root.querySelectorAll<HTMLElement>('[data-sp-panel]').forEach((panel) => {
        const on = panel.dataset.spPanel === pane;
        panel.classList.toggle('is-active', on);
        panel.toggleAttribute('hidden', !on);
      });
    }

    function markLines(lines: number[]): void {
      const codeRoot = root.querySelector('[data-sp-panel="script"]');
      if (!codeRoot) return;
      const set = new Set(lines);
      const marked = codeRoot.querySelectorAll<HTMLElement>('.line[data-line]');
      const all = marked.length > 0 ? marked : codeRoot.querySelectorAll<HTMLElement>('.line');
      let first: HTMLElement | null = null;
      all.forEach((lineEl, i) => {
        const n = marked.length > 0 ? Number(lineEl.dataset.line) : i + 1;
        const current = set.has(n);
        lineEl.classList.toggle('is-current', current);
        lineEl.classList.toggle('is-dimmed', lines.length > 0 && !current);
        if (current && !first) first = lineEl;
      });
      const pre = codeRoot.querySelector('pre');
      if (pre instanceof HTMLElement) scrollIntoScroller(pre, first);
    }

    function render(step: ScenarioStep): void {
      titleEl.textContent = step.title;
      metaEl.textContent = `${tStep} ${index + 1} ${tOf} ${steps.length}`;
      narrationEl.textContent = step.narration;
      if (step.loopLabel) {
        loopEl.hidden = false;
        loopEl.textContent = step.loopLabel;
      } else {
        loopEl.hidden = true;
        loopEl.textContent = '';
      }
      requestEl.replaceChildren();
      responseHeadersEl.replaceChildren();
      responseBodyEl.replaceChildren();
      const hasRequest = step.request.trim().length > 0;
      const split = step.response.trim() ? splitHttpMessage(step.response) : null;
      const hasResponse = Boolean(split);
      const hasHttp = hasRequest || hasResponse;
      const scriptFocus = step.pane === 'script';
      const isSummary = step.pane === 'summary';
      if (hasRequest) renderHighlighted(requestEl, step.request, 'http');
      if (split) {
        renderHighlighted(responseHeadersEl, split.headers, 'http');
        if (split.body) {
          responseBodyPre.hidden = false;
          responseBodyPre.dataset.language = split.bodyLang;
          renderHighlighted(responseBodyEl, split.body, split.bodyLang);
        } else {
          responseBodyPre.hidden = true;
          responseBodyEl.replaceChildren();
        }
      } else {
        responseBodyPre.hidden = true;
      }
      requestCol.hidden = !hasRequest;
      responseCol.hidden = !hasResponse;
      httpWrap.classList.toggle('is-request-only', hasRequest !== hasResponse);
      leftEl.hidden = isSummary || (!hasHttp && !scriptFocus);
      if (!isSummary && (hasHttp || scriptFocus)) setPane(step.pane);

      watchesEl.replaceChildren();
      for (const item of step.watches) {
        const row = document.createElement('div');
        row.className = 'sp-bind-item';
        if (item.changed) row.classList.add('is-changed');
        const nameRow = document.createElement('div');
        nameRow.className = 'sp-bind-name';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tip tip--sim';
        btn.dataset.tipTerm = item.name;
        btn.dataset.tipShort = item.note;
        btn.setAttribute('aria-expanded', 'false');
        const name = document.createElement('code');
        name.textContent = item.name;
        btn.appendChild(name);
        nameRow.appendChild(btn);
        const val = document.createElement('div');
        val.className = 'sp-bind-value';
        if (item.value === 'undefined' || item.value === 'null') val.classList.add('is-undef');
        else if (item.value.startsWith('"') || item.value.startsWith("'")) val.classList.add('is-string');
        else val.classList.add('is-value');
        val.textContent = item.value;
        row.append(nameRow, val);
        watchesEl.appendChild(row);
      }
      watchesWrap.hidden = step.watches.length === 0;
      watchesWrap.classList.toggle(
        'is-fill',
        scriptFocus && step.watches.length > 0 && !step.pendingDom && !step.sink,
      );
      document.dispatchEvent(new Event('csl:tips-refresh'));

      domEl.replaceChildren();
      if (step.dom) domEl.appendChild(renderDom(step.dom));
      const htmlHit = step.pageHtml
        ? renderPageSource(pageHtmlEl, step.pageHtml, step.pageMark)
        : (pageHtmlEl.replaceChildren(), null);
      if (step.pageNote) {
        pageNoteEl.hidden = false;
        pageNoteEl.textContent = step.pageNote;
      } else {
        pageNoteEl.hidden = true;
        pageNoteEl.textContent = '';
      }
      pageWrap.hidden = isSummary || scriptFocus || (!step.dom && !step.pageHtml);
      setPageView(pageWrap.hidden ? pageView : 'html');
      requestAnimationFrame(() => {
        markLines(step.jsLines);
        const treeHit = domEl.querySelector<HTMLElement>('.is-script, .is-clobber, .is-sink');
        scrollIntoScroller(domEl, treeHit);
        const htmlPre = pageHtmlEl.closest('pre');
        if (htmlPre instanceof HTMLElement) scrollIntoScroller(htmlPre, htmlHit);
      });
      pendingEl.replaceChildren();
      if (step.pendingDom) {
        pendingWrap.hidden = false;
        pendingWrap.classList.add('is-fill');
        pendingEl.appendChild(renderDom(step.pendingDom));
      } else {
        pendingWrap.hidden = true;
        pendingWrap.classList.remove('is-fill');
      }

      if (step.sink) {
        sinkWrap.hidden = false;
        renderHighlighted(sinkEl, step.sink.raw, 'html');
      } else {
        sinkWrap.hidden = true;
        sinkEl.replaceChildren();
      }

      if (step.sink?.wouldExecute) {
        fireEl.hidden = false;
        fireEl.textContent = `${tWouldFire} ${step.sink.handlerCode}`;
      } else {
        fireEl.hidden = true;
        fireEl.textContent = '';
      }

      if (step.firefoxNote) {
        firefoxEl.hidden = false;
        firefoxEl.textContent = step.firefoxNote;
      } else {
        firefoxEl.hidden = true;
        firefoxEl.textContent = '';
      }

      rightEl.hidden = isSummary
        || (watchesWrap.hidden
          && pageWrap.hidden
          && pendingWrap.hidden
          && sinkWrap.hidden
          && fireEl.hidden
          && firefoxEl.hidden);
      summaryEl.hidden = !isSummary;
      summaryTextEl.textContent = isSummary ? step.narration : '';
      if (isSummary) narrationEl.textContent = '';
      nextBtn.textContent = isSummary ? tStartOver : tNext;
      editorEl.hidden = index !== 0 || isSummary;
      if (editorEl.hidden) editorEl.open = false;
      if (chromeRestart) chromeRestart.hidden = isSummary;
      gridEl.hidden = isSummary || (leftEl.hidden && rightEl.hidden);
      gridEl.classList.toggle('is-single', leftEl.hidden || rightEl.hidden);

      dotsEl.querySelectorAll<HTMLButtonElement>('.sp-dot').forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-selected', String(i === index));
      });
    }

    function go(next: number): void {
      index = Math.max(0, Math.min(steps.length - 1, next));
      render(steps[index]!);
    }

    function rebuild(opts: { payload: string; trigger: boolean; carlos: boolean; presetId?: string }): void {
      payload = opts.payload.trim() || LAB_PAYLOAD;
      trigger = opts.trigger;
      carlos = opts.carlos;
      payloadEl.value = payload;
      triggerEl.checked = trigger;
      try {
        steps = buildDomClobberingSteps({ payload, trigger, carlos });
      } catch (error) {
        console.error(error);
        return;
      }
      index = 0;
      dotsEl.replaceChildren();
      steps.forEach((step, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'sp-dot';
        dot.setAttribute('role', 'tab');
        dot.title = step.title;
        dot.setAttribute('aria-label', `${tStep} ${i + 1}: ${step.title}`);
        dot.addEventListener('click', () => go(i));
        dotsEl.appendChild(dot);
      });
      root.querySelectorAll<HTMLElement>('[data-sp-preset]').forEach((btn) => {
        btn.classList.toggle(
          'is-active',
          opts.presetId
            ? btn.dataset.spPreset === opts.presetId
            : CLOBBER_PRESETS.some(
                (preset) =>
                  preset.id === btn.dataset.spPreset &&
                  preset.payload === payload &&
                  preset.trigger === trigger,
              ),
        );
      });
      go(0);
    }

    root.querySelector('[data-sp-prev]')?.addEventListener('click', () => go(index - 1));
    nextBtn.addEventListener('click', () => {
      if (steps[index]?.pane === 'summary') {
        go(0);
        return;
      }
      go(index + 1);
    });
    root.querySelectorAll('[data-sp-restart]').forEach((btn) => {
      btn.addEventListener('click', () => go(0));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-sp-page-view]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const view = tab.dataset.spPageView;
        if (view === 'tree' || view === 'html') setPageView(view);
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-sp-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = CLOBBER_PRESETS.find((item) => item.id === btn.dataset.spPreset);
        if (!preset) return;
        rebuild({
          payload: preset.payload,
          trigger: preset.trigger,
          carlos: preset.carlos,
          presetId: preset.id,
        });
      });
    });

    triggerEl.addEventListener('change', () => {
      rebuild({ payload: payloadEl.value, trigger: triggerEl.checked, carlos });
    });

    root.querySelector('[data-sp-apply]')?.addEventListener('click', () => {
      rebuild({ payload: payloadEl.value, trigger: triggerEl.checked, carlos });
    });
    root.querySelector('[data-sp-reset]')?.addEventListener('click', () => {
      rebuild({ payload: LAB_PAYLOAD, trigger: true, carlos: true, presetId: 'lab' });
    });

    payloadEl.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
        event.preventDefault();
        rebuild({ payload: payloadEl.value, trigger: triggerEl.checked, carlos });
      }
    });

    root.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        if (steps[index]?.pane === 'summary') go(0);
        else go(index + 1);
      }
    });

    rebuild({ payload, trigger, carlos, presetId: 'lab' });
  }

  function initAll(): void {
    document.querySelectorAll<HTMLElement>('.scenario-player:not([data-sp-init])').forEach(initPlayer);
  }

  initAll();
  document.addEventListener('astro:after-swap', initAll);
