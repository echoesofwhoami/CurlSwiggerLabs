---
import CodeSnippet from './CodeSnippet.astro'
import type { CompactCollapsibleCodeProps as Props } from '@types'

const { file, title, codeLang } = Astro.props;
---

<details class="compact-collapsible">
  <summary>
    <span class="compact-collapsible-title">{title}</span>
    <span class="expand-hint">click to expand</span>
  </summary>
  <div class="compact-collapsible-content">
    <CodeSnippet file={file} lang={codeLang} />
  </div>
</details>
