---
import { Code } from 'astro:components'
import { cssVariablesTheme } from '../../styles/shiki-css-theme'
import { codeSnippetTransformers, loadCodeSnippet } from '@utils/code-snippet'
import type { CodeSnippetProps as Props } from '@types'
import Choose from '@components/Choose.astro'
import '@styles/mdx/CodeSnippet.css'

const { file, body, lang, noRawHttp, tips } = Astro.props

const snippet = loadCodeSnippet({ file, body, lang, noRawHttp })

const { transformers, httpTransformers, jsonTransformers } = codeSnippetTransformers({
  matchLang: snippet.matchLang,
  tips,
  locals: Astro.locals,
})
---

<div class="code-snippet">
  <Choose if={snippet.hasHttp}>
    <div
      slot="then"
      class="http-toggle-group"
      data-controller="http-toggle"
      data-snippet={snippet.id}
    >
      <div class="http-toggle-tabs" role="tablist" aria-label="View format">
        <button
          class="http-tab is-active"
          role="tab"
          aria-selected="true"
          data-panel="curl"
          data-http-toggle-target="tab"
          data-action="click->http-toggle#select"
          type="button"
        >curl</button>
        <button
          class="http-tab"
          role="tab"
          aria-selected="false"
          data-panel="raw"
          data-http-toggle-target="tab"
          data-action="click->http-toggle#select"
          type="button"
        >Raw HTTP</button>
      </div>

      <div class="http-panel" data-panel="curl" data-http-toggle-target="panel">
        <Code code={snippet.code} lang={snippet.lang} theme={cssVariablesTheme} transformers={transformers} />
      </div>

      <div class="http-panel" data-panel="raw" data-http-toggle-target="panel" hidden>
        <Code code={snippet.httpRaw} lang="http" theme={cssVariablesTheme} transformers={httpTransformers} />
      </div>
    </div>
    <Code slot="else" code={snippet.code} lang={snippet.lang} theme={cssVariablesTheme} transformers={transformers} />
  </Choose>

  <Choose if={snippet.hasBody}>
    <details slot="then" class="compact-collapsible request-body">
      <summary>
        <span class="compact-collapsible-title">Formatted request body</span>
        <span class="expand-hint">click to expand</span>
      </summary>
      <div class="compact-collapsible-content">
        <Code code={snippet.bodyCode} lang="json" theme={cssVariablesTheme} transformers={jsonTransformers} />
      </div>
    </details>
  </Choose>
</div>
