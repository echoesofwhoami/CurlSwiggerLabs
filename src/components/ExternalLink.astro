---
import ExternalLinkSvg from '../assets/external_link.svg';

export interface Props {
  text: string;
  url: string;
}

const { text, url } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="external-link">
  {text}
  <ExternalLinkSvg />
</a>

<style>
  .external-link:hover {
    text-decoration: underline;
  }
</style>
