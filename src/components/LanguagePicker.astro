---
import { languages } from '../i18n/ui';
import { getLocalizedHref, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang: currentLang, currentPath } = Astro.props;
---

<nav aria-label="Language selector" class="lang-picker">
  {Object.entries(languages).map(([lang, label]) => {
    const href = getLocalizedHref(lang as Lang, currentPath);
    const isCurrent = lang === currentLang;
    return (
      <a
        href={href}
        aria-current={isCurrent ? 'page' : undefined}
        hreflang={lang}
        class:list={['lang-link', { active: isCurrent }]}
      >
        {label}
      </a>
    );
  })}
</nav>
