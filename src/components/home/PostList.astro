---
import PostCard from '@components/home/PostCard.astro'
import { categorySectionId } from '@data/categories'
import type { PostListProps as Props } from '@types'
import '@styles/home/PostList.css'

const { category, posts } = Astro.props

const sectionId = categorySectionId(category)

---

<section class="post-list" aria-labelledby={sectionId}>
  <h2 id={sectionId}>{category}</h2>
  <div class="post-list__grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</section>

