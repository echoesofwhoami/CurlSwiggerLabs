---
import { discordCta } from '@utils'
import type { DiscordCtaProps as Props } from '@types'
import Choose from '@components/Choose.astro'
import '@styles/home/DiscordCta.css'

const { compact, inviteUrl, body } = discordCta(Astro.props.compact)
---

<aside class:list={['discord-cta', { compact }]}>
  <div>
    <h2>Talk through a lab</h2>
    <p>{body}</p>
  </div>
  <Choose if={inviteUrl.length > 0}>
    <a slot="then" class="discord-link" href={inviteUrl} target="_blank" rel="noreferrer">
      Join the Discord
    </a>
    <span slot="else" class="discord-unavailable">Invite link coming soon</span>
  </Choose>
</aside>
