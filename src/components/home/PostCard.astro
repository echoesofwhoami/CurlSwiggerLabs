---
import { formatDate, postCardView } from '@utils'
import type { PostCardProps as Props } from '@types'
import Choose from '@components/Choose.astro'
import '@styles/home/PostCard.css'

const { post } = Astro.props

const { href, coverImage } = postCardView(post)
---

<article class="post-card">
  <Choose if={!!coverImage}>
    <a slot="then" class="post-card__image-link" href={href} tabindex="-1" aria-hidden="true">
      {coverImage && (
        <img
          class="post-card__image"
          src={coverImage}
          alt=""
          width="720"
          height="405"
          loading="lazy"
        />
      )}
    </a>
  </Choose>

  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span class:list={['post-card__difficulty', `post-card__difficulty--${post.data.difficulty.toLowerCase()}`]}>
        {post.data.difficulty}
      </span>
    </div>

    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <a class="post-card__read-more" href={href}>
      Read writeup
    </a>
  </div>
</article>
