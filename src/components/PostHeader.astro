---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { formatDate } from '../utils';
import ExternalLink from './ExternalLink.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  labUrl: string;
  date: string;
  difficulty: 'Apprentice' | 'Practitioner' | 'Expert';
  tools: string[];
  series?: string;
  lang?: Lang;
}

const {
  title,
  description,
  category,
  labUrl,
  date,
  difficulty,
  tools,
  series,
  lang = 'en',
} = Astro.props;
const t = useTranslations(lang);
const seriesName = series?.replaceAll('-', ' ');
const descriptionLines = description
  .split(/\n+/)
  .map((line) => line.trim())
  .filter(Boolean);
---

<header class="post-header">
  <h1>{title}</h1>
  <p class="post-source">
    <strong>{category}</strong>
    <span aria-hidden="true">·</span>
    <ExternalLink text={t('post.portswiggerLab')} url={labUrl} />
  </p>
  <div class="post-metadata">
    <span>
      <strong>{t('post.difficulty')}:</strong>
      <span class="difficulty-chip">{difficulty}</span>
    </span>
    <span>
      <strong>{t('post.tools')}:</strong>
      <span class="tool-list">
        {tools.map((tool) => <span class="tool">{tool}</span>)}
      </span>
    </span>
    {seriesName && <span><strong>{t('post.series')}:</strong> {seriesName}</span>}
  </div>
  <div class="post-description">
    {descriptionLines.map((line, index) => (
      <p class:list={[index === descriptionLines.length - 1 && descriptionLines.length > 1 && 'post-description-hook']}>
        {line}
      </p>
    ))}
  </div>
  <small>{formatDate(date, lang)}</small>
</header>

<style>
  .post-header {
    margin: 2.5rem 0 2rem;
  }

  .post-header h1 {
    margin-bottom: 0.75rem;
  }

  .post-description {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 2px solid #dc2626;
  }

  .post-description p {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .post-description p + p {
    margin-top: 0.65rem;
  }

  .post-description-hook {
    color: #f87171;
  }

  .post-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin: 1rem 0;
  }

  .post-metadata {
    display: grid;
    gap: 0.65rem;
    margin: 1rem 0;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .tool-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-left: 0.35rem;
  }

  .tool,
  .difficulty-chip {
    padding: 0.1rem 0.45rem;
    border: 1px solid #334155;
    border-radius: 999px;
    background: #1e293b;
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .difficulty-chip {
    display: inline-block;
    margin-left: 0.35rem;
  }
</style>
