---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import { formatDate } from '../utils';
import psLogo from '../assets/ps_logo.png';
import ExternalLink from './ExternalLink.astro';
import MetaChip from './MetaChip.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  labUrl: string;
  date: string;
  difficulty: 'Apprentice' | 'Practitioner' | 'Expert';
  tools: string[];
  technologies?: string[];
  series?: string;
  lang?: Lang;
}

const {
  title,
  description,
  category,
  labUrl,
  date,
  difficulty,
  tools,
  technologies = [],
  series,
  lang = 'en',
} = Astro.props;
const t = useTranslations(lang);
const seriesName = series?.replaceAll('-', ' ');
const descriptionLines = description
  .split(/\n+/)
  .map((line) => line.trim())
  .filter(Boolean);
const difficultyClass = `difficulty-chip--${difficulty.toLowerCase()}`;
---

<header class="post-header">
  <h1>{title}</h1>
  <p class="post-source">
    <strong>{category}</strong>
    <span aria-hidden="true">·</span>

    <ExternalLink text={t('post.portswiggerLabLink')} url={labUrl} class="portswigger-color">
      <Image src={psLogo} alt="portswigger logo" width={18} height={18} />
    </ExternalLink>
  </p>
  <div class="post-metadata">
    <span>
      <strong>{t('post.difficulty')}</strong>
      <span class:list={['difficulty-chip', difficultyClass]}>
        <span class="difficulty-chip__spacer" aria-hidden="true"></span>
        {difficulty}
      </span>
    </span>
    <span>
      <strong>{t('post.tools')}</strong>
      <span class="chip-list">
        {tools.map((tool) => <MetaChip label={tool} />)}
      </span>
    </span>
    {technologies.length > 0 && (
      <span>
        <strong>{t('post.technologies')}</strong>
        <span class="chip-list">
          {technologies.map((tech) => <MetaChip label={tech} />)}
        </span>
      </span>
    )}
    {seriesName && <span><strong>{t('post.series')}</strong> {seriesName}</span>}
  </div>
  <div class="post-description">
    {descriptionLines.map((line, index) => (
      <p class:list={[index === descriptionLines.length - 1 && descriptionLines.length > 1 && 'post-description-hook']}>
        {line}
      </p>
    ))}
  </div>
  <small>{formatDate(date, lang)}</small>
</header>

<style>
  .post-header {
    margin: 2.5rem 0 2rem;
  }

  .post-header h1 {
    margin-bottom: 0.75rem;
  }

  .post-description {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 2px solid #dc2626;
  }

  .post-description p {
    margin: 0;
    color: #e2e8f0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .post-description p + p {
    margin-top: 0.65rem;
  }

  .post-description-hook {
    color: #f87171;
  }

  .post-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    margin: 1rem 0;
  }

  .ps-logo {
    width: 1em;
    height: 1em;
    margin: 0;
  }

  .post-metadata {
    display: grid;
    gap: 0.65rem;
    margin: 1rem 0;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .post-metadata span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chip-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    vertical-align: middle;
  }

  .difficulty-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem 0.28rem 0.45rem;
    border: 1px solid #334155;
    border-radius: 999px;
    background: #1e293b;
    color: #f8fafc;
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    line-height: 1;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .difficulty-chip__spacer {
    width: 0;
    height: 17px;
    flex-shrink: 0;
  }

  .difficulty-chip--apprentice {
    color: #70d16d;
    border-color: rgba(112, 209, 109, 0.45);
    background: rgba(112, 209, 109, 0.12);
  }

  .difficulty-chip--practitioner {
    color: #4cc1ff;
    border-color: rgba(76, 193, 255, 0.45);
    background: rgba(76, 193, 255, 0.12);
  }

  .difficulty-chip--expert {
    color: #ae75c3;
    border-color: rgba(174, 117, 195, 0.45);
    background: rgba(174, 117, 195, 0.12);
  }
</style>
