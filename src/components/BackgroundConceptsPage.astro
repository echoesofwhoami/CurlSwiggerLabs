---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import CollapsiblePartial from './CollapsiblePartial.astro';
import PartialContainer from './PartialContainer.astro';

const t = useTranslations('en');

const partials = (await getCollection('partials')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const groups = [...new Set(partials.map((entry) => entry.data.category))]
  .sort((a, b) => a.localeCompare(b))
  .map((category) => ({
    category,
    id: category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    partials: partials.filter((entry) => entry.data.category === category),
  }));
---

<main class="concepts-page">
  <header>
    <h1>{t('concepts.title')}</h1>
    <p class="lede">{t('concepts.intro')}</p>
  </header>

  {groups.map((group) => (
    <section class="concepts-group" aria-labelledby={`concepts-${group.id}`}>
      <h2 id={`concepts-${group.id}`}>{group.category}</h2>
      <PartialContainer>
        {group.partials.map((entry) => (
          <CollapsiblePartial
            partial={entry.id.replace(/\.mdx?$/, '')}
            title={entry.data.title}
            lang="en"
          />
        ))}
      </PartialContainer>
    </section>
  ))}
</main>

<style>
  .concepts-page {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    box-sizing: border-box;
    padding-inline: 0;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  header {
    margin-bottom: 2.75rem;
  }

  h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
  }

  .lede {
    max-width: 760px;
    color: #cbd5e1;
    font-size: 1.15rem;
  }

  .concepts-group {
    margin-bottom: 2.75rem;
  }

  .concepts-group h2 {
    margin: 0 0 1rem;
    color: #e2e8f0;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .concepts-page {
      width: min(1180px, calc(100% - 28px));
    }
  }
</style>
