---
import { siteConfig } from '../../site.config';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const inviteUrl = siteConfig.discordInviteUrl.trim();
const body = `Bring questions, confusing HTTP, or requests for the next writeup. Find me on Discord as ${siteConfig.discordHandle}.`;
---

<aside class:list={['discord-cta', { compact }]}>
  <div>
    <h2>Talk through a lab</h2>
    <p>{body}</p>
  </div>
  {
    inviteUrl ? (
      <a class="discord-link" href={inviteUrl} target="_blank" rel="noreferrer">
        Join the Discord
      </a>
    ) : (
      <span class="discord-unavailable">Invite link coming soon</span>
    )
  }
</aside>

<style>
  .discord-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
  }

  h2 {
    margin: 0 0 0.35rem;
    font-size: 1.35rem;
  }

  p {
    margin: 0;
  }

  .discord-link,
  .discord-unavailable {
    flex: 0 0 auto;
    padding: 0.55rem 0.85rem;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .discord-link {
    border: 1px solid var(--accent);
  }

  .discord-unavailable {
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .compact {
    padding: 1rem;
  }

  .compact h2 {
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .discord-cta {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
