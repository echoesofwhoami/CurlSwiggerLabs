---
import { useTranslations, type Lang } from '../i18n/utils';

const lang = (Astro.locals.postLang ?? 'en') as Lang;
const description = Astro.locals.portswiggerDescription;
const t = useTranslations(lang);
---

{description && (
  <details class="compact-collapsible">
    <summary>
      <span class="compact-collapsible-title">{t('post.portswiggerDescription')}</span>
      <span class="expand-hint">{t('partial.clickToExpand')}</span>
    </summary>
    <div class="compact-collapsible-content">
      <p>{description}</p>
    </div>
  </details>
)}
