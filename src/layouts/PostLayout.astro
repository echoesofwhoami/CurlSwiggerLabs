---
import { render } from 'astro:content'
import type { PostLayoutProps as Props } from '@types'
import { categoryForLabel } from '../data/categories'
import { getAdjacentPosts, getPostSlug, getRelatedPosts } from '../utils'
import Layout from './Layout.astro'
import PortswiggerDescription from '../components/post/PortswiggerDescription.astro'
import PostHeader from '../components/post/PostHeader.astro'
import PostNav from '../components/post/PostNav.astro'
import RelatedLabs from '../components/post/RelatedLabs.astro'
import TableOfContents from '../components/post/TableOfContents.astro'
import Quiz from '../components/post/Quiz.astro'
import Term from '../components/mdx/Term.astro'
import TooltipReferences from '../components/post/TooltipReferences.astro'
import '@styles/layouts/PostLayout.css'

const { post } = Astro.props
const slug = getPostSlug(post.id)
const category = categoryForLabel(post.data.category)

Astro.locals.portswiggerDescription = post.data.portswiggerDescription
Astro.locals.usedTips ??= new Set<string>()

const { Content, headings } = await render(post)
const [{ older, newer }, relatedPosts] = await Promise.all([
  getAdjacentPosts(slug),
  getRelatedPosts(slug),
]);

---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={category?.ogImage}
  publishedTime={new Date(post.data.date).toISOString()}
  wide
>
  <article class="post-layout">
    <main>
      <PostHeader
        title={post.data.title}
        description={post.data.description}
        category={post.data.category}
        labUrl={post.data.labUrl}
        date={post.data.date}
        difficulty={post.data.difficulty}
        tools={post.data.tools}
        technologies={post.data.technologies}
        series={post.data.series}
      />
      <TableOfContents headings={headings} />
      <div class="post-content">
        <Content components={{ PortswiggerDescription, Term }} />
      </div>
      <Quiz file={`labs/${slug}`} slug={slug} />
      <TooltipReferences />
      <PostNav older={older} newer={newer} />
      <RelatedLabs posts={relatedPosts} />
    </main>
  </article>
</Layout>

