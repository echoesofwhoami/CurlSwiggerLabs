---
import { render, type CollectionEntry } from 'astro:content';
import { getCategory, getCategoryId } from '../data/categories';
import type { Lang } from '../i18n/utils';
import { getAdjacentPosts, getRelatedPosts } from '../utils';
import Layout from './Layout.astro';
import PortswiggerDescription from '../components/post/PortswiggerDescription.astro';
import PostHeader from '../components/post/PostHeader.astro';
import PostNav from '../components/post/PostNav.astro';
import RelatedLabs from '../components/post/RelatedLabs.astro';
import TableOfContents from '../components/post/TableOfContents.astro';
import Quiz from '../components/post/Quiz.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const slug = post.id.replace(/^es\//, '').replace(/\.mdx?$/, '');
const categoryId = getCategoryId(post.data.category);
const category = categoryId ? getCategory(categoryId, lang) : undefined;

Astro.locals.portswiggerDescription = post.data.portswiggerDescription;
Astro.locals.postLang = lang;

const { Content, headings } = await render(post);
const [{ older, newer }, relatedPosts] = await Promise.all([
  getAdjacentPosts(slug, lang),
  getRelatedPosts(slug, lang),
]);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  type="article"
  image={category?.ogImage}
  publishedTime={new Date(post.data.date).toISOString()}
  wide
>
  <article>
    <main>
      <PostHeader
        title={post.data.title}
        description={post.data.description}
        category={post.data.category}
        labUrl={post.data.labUrl}
        date={post.data.date}
        difficulty={post.data.difficulty}
        tools={post.data.tools}
        technologies={post.data.technologies}
        series={post.data.series}
        lang={lang}
      />
      <TableOfContents headings={headings} lang={lang} />
      <div class="post-content">
        <Content components={{ PortswiggerDescription }} />
      </div>
      <Quiz file={`labs/${slug}`} slug={slug} lang={lang} />
      <PostNav older={older} newer={newer} lang={lang} />
      <RelatedLabs posts={relatedPosts} lang={lang} />
    </main>
  </article>
</Layout>

<style>
  main {
    width: min(var(--content-max-width), calc(100% - 40px));
    max-width: none;
    box-sizing: border-box;
    padding-inline: 0;
    padding-bottom: 4rem;
  }

  :global(.post-content > * + *) {
    margin-top: var(--content-gap);
  }

  @media (max-width: 640px) {
    main {
      width: min(var(--content-max-width), calc(100% - 28px));
    }
  }
</style>
