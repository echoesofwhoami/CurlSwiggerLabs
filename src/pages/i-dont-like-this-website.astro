---
import Layout from '../layouts/Layout.astro'
import { Code } from 'astro:components'
import { placeholderTransformer } from '../shiki/placeholder-transformer'
import { copyButtonTransformer } from '../shiki/copy-button-transformer'
import { cssVariablesTheme } from '../styles/shiki-css-theme'
import { DEFAULT_CONFIG, DEFAULT_PRESET_ID, FONT_OPTIONS, PRESETS } from '../scripts/theme-config'
import { themeTweakerPreview } from '@data/theme-preview'
import PostHeader from '@components/post/PostHeader.astro'
import TableOfContents from '@components/post/TableOfContents.astro'
import '@styles/pages/i-dont-like-this-website.css'

const { shikiThemes, sampleBash, samplePython, previewHeadings } = themeTweakerPreview()

---

<Layout title="I don't like this website" description="Tweak article colors, typography, spacing, and Shiki themes. Configs persist in this browser via localStorage." wide>
  <section class="theme-tweaker" data-controller="theme-tweaker">
    <header class="tweaker-intro">
      <h1>I don't like this website</h1>
      <p>Change how writeups look on this device. Pick a preset, tune the knobs, and apply. The active look is stored in localStorage so it survives reloads and applies across the site. Save a named config to keep multiple setups in this browser only. Nothing is uploaded.</p>
    </header>

    <div class="tweaker-layout">
      <form
        class="tweaker-controls"
        data-action="input->theme-tweaker#input change->theme-tweaker#change"
      >
        <div class="tweaker-controls__scroll">
          <fieldset>
            <legend>Presets</legend>
            <label>
              <span class="sr-only">Presets</span>
              <select
                name="preset"
                data-theme-tweaker-target="presetSelect"
                data-action="change->theme-tweaker#preset"
              >
                <option value="">Custom</option>
                {PRESETS.map((preset) => (
                  <option value={preset.id} selected={preset.id === DEFAULT_PRESET_ID}>
                    {preset.label}
                  </option>
                ))}
              </select>
            </label>
          </fieldset>

          <fieldset>
            <legend>Saved configs</legend>
            <div class="tweaker-row">
              <select name="saved" data-theme-tweaker-target="savedSelect">
                <option value="">—</option>
              </select>
              <button type="button" data-action="theme-tweaker#load">Load</button>
              <button type="button" data-action="theme-tweaker#deleteSaved">Delete</button>
            </div>
            <template data-theme-tweaker-target="savedOption">
              <option></option>
            </template>
            <div class="tweaker-row">
              <input
                type="text"
                name="saveName"
                data-theme-tweaker-target="saveName"
                placeholder="My theme name"
                autocomplete="off"
              />
              <button type="button" data-action="theme-tweaker#save">Save</button>
            </div>
          </fieldset>

          <fieldset>
            <legend>Shiki theme</legend>
            <select name="shikiTheme" data-theme-tweaker-target="field" data-field="shikiTheme">
              {shikiThemes.map((theme) => (
                <option value={theme.id} selected={theme.id === DEFAULT_CONFIG.shikiTheme}>
                  {theme.label}
                </option>
              ))}
            </select>
          </fieldset>

          <fieldset>
            <legend>Font</legend>
            <select name="fontSans" data-theme-tweaker-target="field" data-field="fontSans">
              {FONT_OPTIONS.map((font) => (
                <option value={font.family}>{font.label}</option>
              ))}
            </select>
          </fieldset>

          <fieldset>
            <legend>Colors</legend>
            <div class="color-grid">
              <label><span>Page background</span><input type="color" data-theme-tweaker-target="field" data-field="pageBg" /></label>
              <label><span>Surface</span><input type="color" data-theme-tweaker-target="field" data-field="surface" /></label>
              <label><span>Elevated surface</span><input type="color" data-theme-tweaker-target="field" data-field="surfaceElevated" /></label>
              <label><span>Border</span><input type="color" data-theme-tweaker-target="field" data-field="border" /></label>
              <label><span>Body text</span><input type="color" data-theme-tweaker-target="field" data-field="text" /></label>
              <label><span>Muted text</span><input type="color" data-theme-tweaker-target="field" data-field="textMuted" /></label>
              <label><span>Headings</span><input type="color" data-theme-tweaker-target="field" data-field="heading" /></label>
              <label><span>Accent</span><input type="color" data-theme-tweaker-target="field" data-field="accent" /></label>
              <label><span>Accent hover</span><input type="color" data-theme-tweaker-target="field" data-field="accentHover" /></label>
              <label><span>Code background</span><input type="color" data-theme-tweaker-target="field" data-field="codeBg" /></label>
              <label><span>Inline code background</span><input type="color" data-theme-tweaker-target="field" data-field="codeInlineBg" /></label>
              <label><span>Inline code color</span><input type="color" data-theme-tweaker-target="field" data-field="codeInlineFg" /></label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Typography & layout</legend>
            <label class="range-label">
              <span>Base font size <em data-theme-tweaker-target="readout" data-readout="fontSizeBase"></em></span>
              <input type="range" min="14" max="22" step="1" data-theme-tweaker-target="field" data-field="fontSizeBase" data-type="number" />
            </label>
            <label class="range-label">
              <span>Line height <em data-theme-tweaker-target="readout" data-readout="lineHeight"></em></span>
              <input type="range" min="1.3" max="2" step="0.05" data-theme-tweaker-target="field" data-field="lineHeight" data-type="number" />
            </label>
            <label class="range-label">
              <span>Content width <em data-theme-tweaker-target="readout" data-readout="contentMaxWidth"></em></span>
              <input type="range" min="720" max="1400" step="20" data-theme-tweaker-target="field" data-field="contentMaxWidth" data-type="number" />
            </label>
            <label class="range-label">
              <span>Content gap <em data-theme-tweaker-target="readout" data-readout="contentGap"></em></span>
              <input type="range" min="1" max="3" step="0.05" data-theme-tweaker-target="field" data-field="contentGap" data-type="number" />
            </label>
            <label class="range-label">
              <span>Radius <em data-theme-tweaker-target="readout" data-readout="radius"></em></span>
              <input type="range" min="0" max="16" step="1" data-theme-tweaker-target="field" data-field="radius" data-type="number" />
            </label>
            <label class="range-label">
              <span>Code font size <em data-theme-tweaker-target="readout" data-readout="codeFontSize"></em></span>
              <input type="range" min="12" max="20" step="1" data-theme-tweaker-target="field" data-field="codeFontSize" data-type="number" />
            </label>
          </fieldset>
        </div>

        <div class="tweaker-actions">
          <button type="button" class="primary" data-action="theme-tweaker#apply">Apply to site</button>
          <button type="button" data-action="theme-tweaker#reset">Reset to default</button>
        </div>
      </form>

      <div class="tweaker-preview">
        <h2 class="preview-label">Article preview</h2>
        <article class="preview-article">
          <PostHeader
            title="Sample lab writeup"
            description={'Learn how request bytes decide the outcome.\nThen rebuild the exploit with curl.'}
            category="Authentication"
            labUrl="https://portswigger.net/web-security"
            date="2026-01-15"
            difficulty="Practitioner"
            tools={['curl', 'Burp Suite']}
            technologies={['HTTP']}
          />
          <TableOfContents headings={previewHeadings} />
          <div class="post-content">
            <h2 id="preview-writeup">Writeup</h2>
            <p>
              Body copy uses the muted text token. Links look like
              <a href="#preview-request">this</a>, and inline code like <code>session</code>.
            </p>
            <blockquote>A note that sits on the accent border.</blockquote>
            <table>
              <thead>
                <tr><th>Header</th><th>Value</th></tr>
              </thead>
              <tbody>
                <tr><td>Cookie</td><td><code>session=…</code></td></tr>
                <tr><td>Method</td><td>POST</td></tr>
              </tbody>
            </table>

            <h3 id="preview-request">The request</h3>
            <div class="code-snippet">
              <Code
                code={sampleBash}
                lang="bash"
                theme={cssVariablesTheme}
                transformers={[placeholderTransformer, copyButtonTransformer]}
              />
            </div>

            <h3 id="preview-script">The script</h3>
            <div class="code-snippet">
              <Code
                code={samplePython}
                lang="python"
                theme={cssVariablesTheme}
                transformers={[placeholderTransformer, copyButtonTransformer]}
              />
            </div>

            <details class="collapsible-partial" open>
              <summary>
                <span class="partial-summary-text">
                  <span class="partial-title">Necessary Background Concepts To Solve The Lab</span>
                  <span class="expand-hint">click to expand</span>
                </span>
              </summary>
              <div class="partial-content">
                <p>Collapsed sections inherit surface and border tokens.</p>
              </div>
            </details>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>
