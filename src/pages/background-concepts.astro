---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPostSlug } from '../utils';
import CollapsiblePartial from '../components/mdx/CollapsiblePartial.astro';
import PartialContainer from '../components/mdx/PartialContainer.astro';
import '@styles/pages/background-concepts.css';

Astro.locals.usedTips ??= new Set<string>();

const partials = (await getCollection('partials')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const groups = [...new Set(partials.map((entry) => entry.data.category))]
  .sort((a, b) => a.localeCompare(b))
  .map((category) => ({
    category,
    id: category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    partials: partials.filter((entry) => entry.data.category === category),
  }));

---

<Layout title="Background Concepts" description="Reusable background concepts used across CurlSwiggerLabs writeups." wide>
<main class="concepts-page">
  <header>
    <h1>Background Concepts</h1>
    <p class="lede">Expand any topic below for the same background material reused across the lab writeups. These are the building blocks that sit behind JWT, OAuth, SSRF, smuggling, PHP deserialization, and prototype pollution labs.</p>
  </header>

  {groups.map((group) => (
    <section class="concepts-group" aria-labelledby={`concepts-${group.id}`}>
      <h2 id={`concepts-${group.id}`}>{group.category}</h2>
      <PartialContainer>
        {group.partials.map((entry) => (
          <CollapsiblePartial
            partial={getPostSlug(entry.id)}
            title={entry.data.title}
          />
        ))}
      </PartialContainer>
    </section>
  ))}
</main>
</Layout>
